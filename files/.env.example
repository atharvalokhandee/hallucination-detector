# ── Copy this file to .env and fill in your real keys ────────────
# Never commit .env to GitHub!

# Groq API — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API — https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Redis connection (local default shown; update for cloud Redis)
REDIS_URL=redis://localhost:6379

# Pipeline tuning — tweak these without touching code
SIMILARITY_THRESHOLD_HIGH=0.75   # above this = "supported" directly
SIMILARITY_THRESHOLD_LOW=0.40    # below this = "contradicted" directly
CACHE_TTL_SECONDS=3600           # 1 hour claim cache
TAVILY_MAX_RESULTS=5             # evidence snippets per claim
GROQ_MODEL=llama-3.3-70b-versatile
